---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

import { getAuthor } from '@/utils/get-author';

interface Props {
  title: string;
  subtitle?: string;
  entries: CollectionEntry<'content'>[];
  icon: string;
  basePath: string;
  accentClass?: string;
}

const {
  title,
  subtitle,
  entries,
  icon,
  basePath,
  accentClass = 'from-primary to-secondary',
} = Astro.props;

function excerpt(body: string, max = 140): string {
  const text = body
    .replace(/^#.*$/gm, '')
    .replace(/[#*`>_-]/g, '')
    .trim();
  return text.length > max ? text.slice(0, max).trimEnd() + '\u2026' : text;
}

function formatDate(d: string | Date): string {
  return new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

interface CardData {
  href: string;
  title: string;
  excerpt: string;
  author?: string;
  date: string;
  tags: string[];
  image?: string;
}

const cards: CardData[] = entries.map((entry) => {
  const data = entry.data as Record<string, unknown>;
  const image = data.image as { url?: string } | undefined;
  const cover = data.cover as { url?: string } | undefined;
  const author = (getAuthor(data.author as string)?.name ?? data.author) as string | undefined;
  const tags = (data.tags as string[] | undefined) ?? [];
  const typeSlug = entry.id.split('/')[0];
  const slug = entry.id.replace(`${typeSlug}/`, '');
  return {
    href: `${basePath}/${slug}`,
    title: data.title as string,
    excerpt: excerpt(entry.body ?? ''),
    author,
    date: formatDate(data.datePublished as string),
    tags,
    image: image?.url ?? cover?.url,
  };
});
---

<section class="py-12 lg:py-16">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center gap-4 mb-8">
      <div
        class={`h-14 w-14 rounded-2xl bg-gradient-to-br ${accentClass} flex items-center justify-center shrink-0`}
      >
        <Icon name={`lucide:${icon}`} class="h-7 w-7 text-white" />
      </div>
      <div>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight">{title}</h1>
        {subtitle && <p class="text-base-content/60 mt-1">{subtitle}</p>}
      </div>
      <span class="badge badge-lg badge-outline ml-auto hidden sm:inline-flex"
        >{entries.length} {entries.length === 1 ? 'item' : 'items'}</span
      >
    </div>

    {
      entries.length === 0 ? (
        <div class="card bg-base-100 border border-base-300">
          <div class="card-body items-center text-center py-16">
            <Icon name="lucide:package-open" class="h-12 w-12 text-base-content/30 mb-4" />
            <p class="text-lg font-medium text-base-content/60">
              No {title.toLowerCase()} published yet.
            </p>
            <p class="text-sm text-base-content/40">Check back soon — new content is on the way.</p>
          </div>
        </div>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {cards.map((card) => (
            <a
              href={card.href}
              class="group card bg-base-100 border border-base-300 rounded-2xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
            >
              {card.image && (
                <figure class="relative aspect-[16/9] overflow-hidden">
                  <img
                    src={card.image}
                    alt={card.title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-base-300/40 to-transparent" />
                </figure>
              )}
              <div class="card-body p-5">
                {card.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1 mb-2">
                    {card.tags.slice(0, 3).map((tag) => (
                      <span class="badge badge-sm badge-ghost">{tag}</span>
                    ))}
                  </div>
                )}
                <h2 class="card-title text-lg leading-snug group-hover:text-primary transition-colors">
                  {card.title}
                </h2>
                <p class="text-sm text-base-content/60 line-clamp-2">{card.excerpt}</p>
                <div class="flex items-center gap-3 text-xs text-base-content/50 mt-auto pt-3">
                  {card.author && (
                    <span class="flex items-center gap-1">
                      <Icon name="lucide:user" class="h-3 w-3" /> {card.author}
                    </span>
                  )}
                  <span class="flex items-center gap-1">
                    <Icon name="lucide:calendar" class="h-3 w-3" /> {card.date}
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>
