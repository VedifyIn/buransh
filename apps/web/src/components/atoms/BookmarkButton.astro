---
import { Icon } from 'astro-icon/components';

interface Props {
  active?: boolean;
  size?: 'sm' | 'md';
}

const { active = false, size = 'md' } = Astro.props;

const sizes: Record<string, string> = {
  sm: 'btn-sm',
  md: '',
};
---

<button class={`btn ${sizes[size]} gap-2 bookmark-btn ${active ? 'btn-primary' : 'btn-outline'}`}>
  <Icon name={active ? 'lucide:bookmark' : 'lucide:bookmark'} class="h-4 w-4" />
  <span>{active ? 'Saved' : 'Save'}</span>
</button>

<script>
  document.querySelectorAll('.bookmark-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const isOutline = btn.classList.contains('btn-outline');
      if (isOutline) {
        btn.classList.remove('btn-outline');
        btn.classList.add('btn-primary');
        btn.querySelector('span').textContent = 'Saved';
      } else {
        btn.classList.remove('btn-primary');
        btn.classList.add('btn-outline');
        btn.querySelector('span').textContent = 'Save';
      }
    });
  });
</script>
