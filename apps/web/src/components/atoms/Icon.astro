---
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { name, size = 'md', class: className = '' } = Astro.props;

const sizes: Record<string, string> = {
  xs: 'h-3 w-3',
  sm: 'h-4 w-4',
  md: 'h-5 w-5',
  lg: 'h-6 w-6',
  xl: 'h-8 w-8',
};
---

<Icon name={name} class={`${sizes[size]} ${className}`} />
