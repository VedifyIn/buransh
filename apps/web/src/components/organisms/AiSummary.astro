---
import { Icon } from 'astro-icon/components';
import Card from '@/components/molecules/Card.astro';

interface Props {
  summary: string;
  keyPoints?: string[];
}

const { summary, keyPoints = [] } = Astro.props;
---

<Card variant="gradient" gradientFrom="primary" gradientTo="secondary" padding="md">
  <div class="flex items-center gap-2 mb-3">
    <div
      class="h-8 w-8 rounded-lg bg-gradient-to-br from-primary to-secondary flex items-center justify-center"
    >
      <Icon name="lucide:sparkles" class="h-4 w-4 text-primary-content" />
    </div>
    <div>
      <h3 class="font-semibold leading-tight">AI Summary</h3>
      <p class="text-xs text-base-content/50">Generated in 2.3s</p>
    </div>
  </div>
  <p class="text-sm text-base-content/80 leading-relaxed">{summary}</p>
  {
    keyPoints.length > 0 && (
      <div class="mt-4 pt-4 border-t border-base-300">
        <p class="text-xs font-semibold uppercase tracking-wider text-base-content/60 mb-2">
          Key Points
        </p>
        <ul class="space-y-1.5">
          {keyPoints.map((point) => (
            <li class="flex items-start gap-2 text-sm">
              <Icon name="lucide:check-circle-2" class="h-4 w-4 text-success shrink-0 mt-0.5" />
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</Card>
