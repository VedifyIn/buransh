---
import { Icon } from 'astro-icon/components';
import type { BaseFrontmatter } from '@vedify/schema';
import ContentLayout from '@/layouts/ContentLayout.astro';
import TagList from '@/components/molecules/TagList.astro';
import AiSummary from '@/components/organisms/AiSummary.astro';
import AdSlot from '@/components/molecules/AdSlot.astro';
import AuthorCard from '@/components/organisms/AuthorCard.astro';
import InteractionGroup from '@/components/molecules/InteractionGroup.astro';
import CommentSection from '@/components/molecules/CommentSection.astro';
import TableOfContents from '@/components/molecules/TableOfContents.astro';
import ExpertOpinion from '@/components/organisms/ExpertOpinion.astro';
import { getAuthor } from '@/utils/get-author';

type Props = BaseFrontmatter;
const content = Astro.props as Props;

const tocItems = [
  { id: 'introduction', title: 'Introduction' },
  { id: 'the-problem', title: 'The Problem with Conventional Wisdom' },
  { id: 'a-better-approach', title: 'A Better Approach: Event Sourcing' },
  { id: 'tradeoffs', title: 'Tradeoffs and When to Use It' },
  { id: 'conclusion', title: 'Conclusion' },
];
const resolved = getAuthor(content.author);
const author = {
  name: resolved?.name ?? content.author,
  role: resolved?.role ?? '',
  bio: resolved?.bio ?? '',
  avatar:
    resolved?.avatar ??
    'https://images.pexels.com/photos/1681010/pexels-photo-1681010.jpeg?auto=compress&cs=tinysrgb&w=160&h=160&fit=crop',
  stats: resolved?.stats ?? [],
};
---

<ContentLayout
  frontmatter={content}
  title={content.title}
  description={content.description}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Essays', href: '/essay' },
    { label: content.title },
  ]}
  currentSection="Essay"
  author={author.name}
  publishedTime={`${content.datePublished}T08:00:00Z`}
>
  <article class="max-w-7xl mx-auto px-4 py-8 lg:py-12">
    <header class="max-w-3xl mx-auto mb-10 text-center">
      <div class="flex items-center justify-center gap-2 mb-4">
        <span class="badge badge-primary badge-outline">Architecture</span>
        <span class="badge badge-ghost">Engineering</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">{content.title}</h1>
      <p class="text-lg text-base-content/60 mb-6 max-w-2xl mx-auto">{content.description}</p>
      <div class="flex items-center justify-center gap-4 text-sm text-base-content/60">
        <div class="flex items-center gap-2">
          <div class="avatar">
            <div class="w-8 rounded-full"><img src={author.avatar} alt={author.name} /></div>
          </div>
          <span class="font-medium text-base-content">{author.name}</span>
        </div>
        <span>&bull;</span>
        <span class="flex items-center gap-1"
          ><Icon name="lucide:calendar" class="h-3.5 w-3.5" /> {content.datePublished}</span
        >
        {
          content.readingTime && (
            <>
              <>
                <span>&bull;</span>
                <span class="flex items-center gap-1">
                  <Icon name="lucide:clock" class="h-3.5 w-3.5" /> {content.readingTime} min read
                </span>
              </>
            </>
          )
        }
      </div>
    </header>
    <figure class="max-w-4xl mx-auto mb-10">
      <img
        src="https://images.pexels.com/photos/1181271/pexels-photo-1181271.jpeg?auto=compress&cs=tinysrgb&w=1400&h=700&fit=crop"
        alt={content.title}
        class="rounded-2xl w-full object-cover aspect-[2/1]"
        loading="eager"
      />
    </figure>
    <div class="grid lg:grid-cols-[1fr_280px] gap-8 max-w-4xl mx-auto">
      <div class="min-w-0">
        <AiSummary
          summary={content.description}
          keyPoints={[
            'CRUD loses history; the "why" behind current state disappears.',
            'Event sourcing stores facts; state is a projection of those facts.',
            'Adds complexity in storage, tooling, and mental model.',
            'Best for audit-heavy, multi-stakeholder, or business-critical systems.',
          ]}
        />
        <div class="prose-vedify mt-8"><slot /></div>
        <TagList tags={content.tags} />
        <div class="my-8"><InteractionGroup /></div>
        <div class="my-8"><AdSlot variant="banner" /></div>
        <ExpertOpinion
          expert="Dr. Lena Hoffmann"
          role="Distributed Systems Researcher, TU Munich"
          avatar="https://images.pexels.com/photos/733872/pexels-photo-733872.jpeg?auto=compress&cs=tinysrgb&w=160&h=160&fit=crop"
          quote="Event sourcing is one of those ideas that sounds academic until you've been burned by an audit. Then it becomes obvious."
          rating={5}
        />
        <div class="mt-12"><CommentSection /></div>
      </div>
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">
          <TableOfContents items={tocItems} />
          <AdSlot variant="sidebar" />
          <AuthorCard {...author} />
        </div>
      </aside>
    </div>
  </article>
</ContentLayout>
