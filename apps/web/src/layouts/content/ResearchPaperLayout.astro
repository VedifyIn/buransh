---
import { Icon } from 'astro-icon/components';
import { researchSchema } from '@vedify/schema';
import type { z } from '@vedify/schema';
import ContentLayout from '@/layouts/ContentLayout.astro';
import ResearchMeta from '@/components/organisms/ResearchMeta.astro';
import AiSummary from '@/components/organisms/AiSummary.astro';
import TagList from '@/components/molecules/TagList.astro';
import InteractionGroup from '@/components/molecules/InteractionGroup.astro';
import CommentSection from '@/components/molecules/CommentSection.astro';
import AuthorCard from '@/components/organisms/AuthorCard.astro';
import AdSlot from '@/components/molecules/AdSlot.astro';

type Props = z.infer<typeof researchSchema>;
const content = Astro.props as Props;

const paper = {
  authors: content.author,
  journal: content.journal ?? '',
  citation: content.citation ?? '',
  published: content.datePublished,
  doi: content.doi ?? '',
};
---

<ContentLayout
  frontmatter={content}
  title={content.title}
  description={content.description}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Research', href: '/research-paper' },
    { label: content.title },
  ]}
  currentSection="Research Paper"
>
  <div class="max-w-7xl mx-auto px-4 py-8 lg:py-12">
    <div class="grid lg:grid-cols-[1fr_320px] gap-8">
      <div class="min-w-0">
        <div class="flex items-center gap-2 mb-3">
          <span class="badge badge-primary gap-1"
            ><Icon name="lucide:file-text" class="h-3.5 w-3.5" /> Research Paper</span
          >
          <span class="badge badge-ghost">Peer-reviewed</span>
          <span class="badge badge-success gap-1"
            ><Icon name="lucide:check-circle-2" class="h-3 w-3" /> Open Access</span
          >
        </div>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-3">{content.title}</h1>
        <p class="text-base-content/70 mb-4">{paper.authors}</p>
        <p class="text-sm text-base-content/60 mb-6"><em>{paper.journal}</em>, {paper.published}</p>

        <div class="flex flex-wrap gap-2 mb-6">
          <a href="#" class="btn btn-primary btn-sm gap-2"
            ><Icon name="lucide:download" class="h-4 w-4" /> PDF</a
          >
          <a href="#" class="btn btn-outline btn-sm gap-2"
            ><Icon name="lucide:link" class="h-4 w-4" /> DOI</a
          >
          <a href="#" class="btn btn-ghost btn-sm gap-2"
            ><Icon name="lucide:quote" class="h-4 w-4" /> Cite</a
          >
          <a href="#" class="btn btn-ghost btn-sm gap-2"
            ><Icon name="lucide:bookmark" class="h-4 w-4" /> Save</a
          >
        </div>

        <AiSummary
          summary={content.description}
          keyPoints={[
            'Causal consistency achievable with sub-50ms overhead in 92% of operations.',
            'Protocol refinement reduces metadata size by 64%.',
            '3.1x improvement in tail latency.',
          ]}
        />

        <div class="prose-vedify mt-8"><slot /></div>

        <div class="mt-8"><TagList tags={content.tags} /></div>
        <div class="my-8"><InteractionGroup /></div>
        <div class="my-8"><AdSlot variant="banner" /></div>
        <div class="mt-12"><CommentSection /></div>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <ResearchMeta paper={paper} />
        <AuthorCard
          name="Dr. Lena Hoffmann"
          role="Lead Author, TU Munich"
          bio="Distributed systems researcher focused on consistency models."
          avatar="https://images.pexels.com/photos/733872/pexels-photo-733872.jpeg?auto=compress&cs=tinysrgb&w=160&h=160&fit=crop"
          stats={[
            { label: 'Papers', value: 38 },
            { label: 'Citations', value: '4.2k' },
          ]}
        />
        <AdSlot variant="sidebar" />
      </aside>
    </div>
  </div>
</ContentLayout>
