---
import '../styles/global.css';
import SiteHeader from '@/components/organisms/SiteHeader.astro';
import SiteFooter from '@/components/organisms/SiteFooter.astro';
import JsonLdIndex from '@/components/JsonLdIndex.astro';
import { getOrgConfig } from '@/utils/org-config';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Quality content for curious minds. Essays, tutorials, courses, and more.',
  image = 'https://images.pexels.com/photos/268415/pexels-photo-268415.jpeg?auto=compress&cs=tinysrgb&w=1200&h=630&fit=crop',
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const siteUrl = String(Astro.site ?? canonicalURL.origin);
const org = getOrgConfig();
---

<!doctype html>
<html lang="en" data-theme="vedify">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={org.name || 'Vedify'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" content="hsl(var(--p))" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <JsonLdIndex siteUrl={siteUrl} title={title} description={description} organization={org} />
    <script is:inline>
      (() => {
        var stored = localStorage.getItem('daisyui-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute(
          'data-theme',
          stored || (prefersDark ? 'vedify-dark' : 'vedify'),
        );
        var dim = localStorage.getItem('vedify-dim-mode');
        if (dim && dim !== 'default') document.documentElement.setAttribute('data-dim-mode', dim);
        var f = localStorage.getItem('vedify-font');
        if (f)
          document.documentElement.style.setProperty(
            '--reading-font',
            f === 'serif'
              ? 'Georgia, serif'
              : f === 'mono'
                ? getComputedStyle(document.documentElement)
                    .getPropertyValue('--font-mono')
                    .trim() || 'monospace'
                : getComputedStyle(document.documentElement)
                    .getPropertyValue('--font-sans')
                    .trim() || 'sans-serif',
          );
        var s = localStorage.getItem('vedify-font-size');
        if (s) document.documentElement.style.setProperty('--reading-size', s + 'px');
      })();
    </script>
  </head>
  <body class="min-h-screen bg-base-100 text-base-content antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[100] btn btn-primary btn-sm"
      >Skip to main content</a
    >
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
