---
import { Icon } from 'astro-icon/components';
import Layout from '@/layouts/Layout.astro';
import Logo from '@/components/atoms/Logo.astro';

export const prerender = false;
---

<Layout
  title="Sign In - Vedify"
  description="Sign in to your Vedify account to sync bookmarks, preferences, and reading progress."
>
  <section class="min-h-[calc(100vh-4rem)] flex items-center justify-center py-12 px-4">
    <div
      class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-secondary/5 pointer-events-none"
    >
    </div>

    <div class="relative w-full max-w-md">
      <div class="card bg-base-100 border border-base-300 shadow-xl rounded-2xl overflow-hidden">
        <!-- Header -->
        <div class="text-center pt-8 pb-6 px-8">
          <a href="/" class="inline-flex items-center gap-2 mb-6">
            <Logo size="lg" />
            <span class="font-bold text-2xl">Vedify</span>
          </a>
          <h1 class="text-2xl font-bold tracking-tight">Welcome back</h1>
          <p class="text-base-content/60 text-sm mt-1">
            Sign in to sync your reading and preferences
          </p>
        </div>

        <!-- Gravatar preview -->
        <div class="px-8 pb-4">
          <div
            id="gravatar-preview"
            class="flex items-center gap-3 p-3 rounded-xl bg-base-200/50 border border-base-300 transition-all opacity-50"
          >
            <div
              id="gravatar-img-wrap"
              class="w-12 h-12 rounded-full bg-base-300 flex items-center justify-center overflow-hidden shrink-0"
            >
              <Icon name="lucide:user" class="h-6 w-6 text-base-content/40" />
            </div>
            <div class="min-w-0">
              <p id="gravatar-name" class="text-sm font-medium text-base-content/50 truncate">
                Your gravatar appears here
              </p>
              <p id="gravatar-email" class="text-xs text-base-content/40 truncate">
                Enter your email below
              </p>
            </div>
          </div>
        </div>

        <!-- Form -->
        <form id="login-form" class="card-body pt-2 gap-4">
          <div class="form-control">
            <label class="label" for="email"
              ><span class="label-text font-medium">Email</span></label
            >
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="you@example.com"
              class="input input-bordered w-full"
            />
          </div>
          <div class="form-control">
            <div class="flex items-center justify-between">
              <label class="label" for="password"
                ><span class="label-text font-medium">Password</span></label
              >
              <a href="#" class="text-xs text-primary hover:underline">Forgot password?</a>
            </div>
            <div class="relative">
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                placeholder="········"
                class="input input-bordered w-full pr-12"
              />
              <button
                type="button"
                id="toggle-password"
                class="btn btn-ghost btn-sm btn-circle absolute right-2 top-1/2 -translate-y-1/2"
                aria-label="Toggle password visibility"
              >
                <Icon name="lucide:eye" class="h-4 w-4" id="eye-icon" />
              </button>
            </div>
          </div>

          <div id="login-error" class="alert alert-error py-2 px-3 text-sm hidden"></div>
          <div id="login-success" class="alert alert-success py-2 px-3 text-sm hidden"></div>

          <button type="submit" id="login-btn" class="btn btn-primary w-full gap-2">
            <span id="btn-text">Sign In</span>
            <Icon name="lucide:arrow-right" class="h-4 w-4" id="btn-arrow" />
            <span id="btn-spinner" class="loading loading-spinner loading-sm hidden"></span>
          </button>
        </form>

        <!-- Divider -->
        <div class="px-8 py-2">
          <div class="divider text-xs text-base-content/40 before:bg-base-300 after:bg-base-300">
            OR
          </div>
        </div>

        <!-- Sign up link -->
        <div class="text-center pb-8 px-8">
          <p class="text-sm text-base-content/60">
            Don't have an account? <a
              href="/login?mode=signup"
              id="signup-link"
              class="text-primary font-medium hover:underline">Create one</a
            >
          </p>
        </div>
      </div>

      <p class="text-center text-xs text-base-content/40 mt-4">
        By signing in you agree to our <a href="#" class="hover:underline">Terms</a> and <a
          href="#"
          class="hover:underline">Privacy Policy</a
        >.
      </p>
    </div>
  </section>
</Layout>

<script>
  const SUPABASE_URL = import.meta.env.VITE_SUPABASE_URL;
  const SUPABASE_ANON_KEY = import.meta.env.VITE_SUPABASE_ANON_KEY;

  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const toggleBtn = document.getElementById('toggle-password')!;
  const eyeIcon = document.getElementById('eye-icon')!;
  const form = document.getElementById('login-form') as HTMLFormElement;
  const loginBtn = document.getElementById('login-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text')!;
  const btnArrow = document.getElementById('btn-arrow')!;
  const btnSpinner = document.getElementById('btn-spinner')!;
  const errorBox = document.getElementById('login-error')!;
  const successBox = document.getElementById('login-success')!;
  const gravatarPreview = document.getElementById('gravatar-preview')!;
  const gravatarImgWrap = document.getElementById('gravatar-img-wrap')!;
  const gravatarName = document.getElementById('gravatar-name')!;
  const gravatarEmail = document.getElementById('gravatar-email')!;

  // --- Gravatar preview ---
  async function updateGravatar() {
    const email = emailInput.value.trim().toLowerCase();
    if (!email || !email.includes('@')) {
      gravatarPreview.classList.add('opacity-50');
      gravatarImgWrap.innerHTML =
        '<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-base-content/40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>';
      gravatarName.textContent = 'Your gravatar appears here';
      gravatarName.className = 'text-sm font-medium text-base-content/50 truncate';
      gravatarEmail.textContent = 'Enter your email below';
      gravatarEmail.className = 'text-xs text-base-content/40 truncate';
      return;
    }

    const hash = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(email));
    const hex = Array.from(new Uint8Array(hash))
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('');
    const gravatarUrl = `https://cravatar.eu/avatar/${hex}?d=retro&s=96`;

    const img = new Image();
    img.onload = () => {
      gravatarImgWrap.innerHTML = '';
      img.className = 'w-12 h-12 rounded-full object-cover';
      gravatarImgWrap.appendChild(img);
      gravatarPreview.classList.remove('opacity-50');
      gravatarName.textContent = email.split('@')[0];
      gravatarName.className = 'text-sm font-medium text-base-content truncate';
      gravatarEmail.textContent = email;
      gravatarEmail.className = 'text-xs text-base-content/50 truncate';
    };
    img.src = gravatarUrl;
  }

  emailInput.addEventListener('input', () => void updateGravatar());
  emailInput.addEventListener('blur', () => void updateGravatar());

  // --- Password toggle ---
  toggleBtn.addEventListener('click', () => {
    const isPassword = passwordInput.type === 'password';
    passwordInput.type = isPassword ? 'text' : 'password';
    eyeIcon.setAttribute('data-icon', isPassword ? 'lucide:eye-off' : 'lucide:eye');
    eyeIcon.setAttribute('name', isPassword ? 'lucide:eye-off' : 'lucide:eye');
  });

  // --- Form submit ---
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');
    successBox.classList.add('hidden');

    loginBtn.disabled = true;
    btnText.textContent = 'Signing in\u2026';
    btnArrow.classList.add('hidden');
    btnSpinner.classList.remove('hidden');

    try {
      const res = await fetch(`${SUPABASE_URL}/auth/v1/token?grant_type=password`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          apikey: SUPABASE_ANON_KEY,
        },
        body: JSON.stringify({
          email: emailInput.value,
          password: passwordInput.value,
        }),
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(
          data.error_description || data.msg || data.error || 'Invalid email or password',
        );
      }

      // Set the access token cookie
      document.cookie = `sb-access-token=${data.access_token}; path=/; max-age=3600; samesite=lax${location.protocol === 'https:' ? '; secure' : ''}`;
      document.cookie = `sb-refresh-token=${data.refresh_token}; path=/; max-age=604800; samesite=lax${location.protocol === 'https:' ? '; secure' : ''}`;

      successBox.textContent = `Welcome back, ${data.user?.email ?? emailInput.value}! Redirecting\u2026`;
      successBox.classList.remove('hidden');

      setTimeout(() => {
        window.location.href = '/settings';
      }, 800);
    } catch (err) {
      errorBox.textContent =
        err instanceof Error ? err.message : 'Sign in failed. Please try again.';
      errorBox.classList.remove('hidden');
      loginBtn.disabled = false;
      btnText.textContent = 'Sign In';
      btnArrow.classList.remove('hidden');
      btnSpinner.classList.add('hidden');
    }
  });
</script>
