---
import Layout from '@/layouts/Layout.astro';
import { getContentCounts } from '@/lib/content/getAllContent';
import { Icon } from 'astro-icon/components';

// Optimized: Load only counts instead of all content
const contentCounts = await getContentCounts();
const types: { name: string; label: string; icon: string; href: string }[] = [
  { name: 'essay', label: 'Essays', icon: 'file-text', href: '/essay' },
  { name: 'tutorial', label: 'Tutorials', icon: 'code', href: '/tutorial' },
  { name: 'course', label: 'Courses', icon: 'book-open', href: '/course' },
  { name: 'podcast', label: 'Podcasts', icon: 'mic', href: '/podcast' },
  { name: 'recipe', label: 'Recipes', icon: 'utensils', href: '/recipe' },
  { name: 'book', label: 'Books', icon: 'book-open', href: '/book' },
  { name: 'book-review', label: 'Book Reviews', icon: 'book-open-check', href: '/book-review' },
  { name: 'research-paper', label: 'Research', icon: 'file-text', href: '/research-paper' },
  { name: 'patent', label: 'Patents', icon: 'award', href: '/patent' },
  { name: 'quote', label: 'Quotes', icon: 'quote', href: '/quote' },
  { name: 'event', label: 'Events', icon: 'trophy', href: '/event' },
  { name: 'conference', label: 'Conferences', icon: 'calendar', href: '/conference' },
  { name: 'workshop', label: 'Workshops', icon: 'wrench', href: '/workshop' },
  { name: 'webinar', label: 'Webinars', icon: 'video', href: '/webinar' },
  { name: 'course-lesson', label: 'Lessons', icon: 'play-circle', href: '/course-lesson' },
];
---

<Layout
  title="About - Vedify"
  description="Vedify is a content platform for curious minds. Learn about our mission, our content types, and what makes us different."
>
  <section class="py-16 lg:py-24">
    <div class="max-w-3xl mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-6">About Vedify</h1>
      <p class="text-lg text-base-content/70 mb-8">
        Vedify is a content platform built for curious minds. We believe quality content deserves a
        quality reading experience — whether it's an essay, a tutorial, a course, a recipe, or a
        research paper.
      </p>
      <p class="text-base-content/70 mb-8">
        Every piece on Vedify is crafted with care, optimized for learning, and designed for the
        modern web. We support fifteen content types out of the box, each with its own purpose-built
        layout, structured metadata, and rich interactions.
      </p>

      <div class="card bg-base-100 border border-base-300 rounded-2xl mb-12">
        <div class="card-body">
          <h2 class="card-title text-xl flex items-center gap-2 mb-4">
            <Icon name="lucide:layers" class="h-5 w-5 text-primary" />
            Content Types
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {
              types.map((t) => {
                const count = contentCounts[t.name] || 0;
                return (
                  <a
                    href={t.href}
                    class="flex items-center gap-3 p-3 rounded-xl border border-base-300 hover:border-primary/30 hover:bg-base-200/50 transition-all"
                  >
                    <Icon name={`lucide:${t.icon}`} class="h-5 w-5 text-base-content/60 shrink-0" />
                    <div class="min-w-0">
                      <p class="text-sm font-medium truncate">{t.label}</p>
                      <p class="text-xs text-base-content/40">
                        {count} {count === 1 ? 'item' : 'items'}
                      </p>
                    </div>
                  </a>
                );
              })
            }
          </div>
        </div>
      </div>

      <h2 class="text-2xl font-bold mb-4">Our Principles</h2>
      <div class="space-y-4 mb-12">
        {
          [
            {
              icon: 'shield-check',
              title: 'Privacy First',
              desc: "Your data is yours. We don't sell it, track you across the web, or show ads.",
            },
            {
              icon: 'eye',
              title: 'Beautiful by Default',
              desc: 'Every content type has a purpose-built layout designed for readability and engagement.',
            },
            {
              icon: 'zap',
              title: 'Fast & Accessible',
              desc: 'Static-first architecture means pages load instantly. WCAG 2.1 compliant by design.',
            },
            {
              icon: 'rss',
              title: 'Open & Subscribable',
              desc: 'RSS feeds, open data, and no walled gardens. Subscribe your way.',
            },
          ].map((p) => (
            <div class="flex gap-4">
              <div class="h-10 w-10 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                <Icon name={`lucide:${p.icon}`} class="h-5 w-5 text-primary" />
              </div>
              <div>
                <h3 class="font-semibold">{p.title}</h3>
                <p class="text-sm text-base-content/60">{p.desc}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div
        class="card bg-gradient-to-br from-primary to-secondary text-primary-content rounded-2xl"
      >
        <div class="card-body items-center text-center">
          <h2 class="text-2xl font-bold">Ready to dive in?</h2>
          <p class="text-primary-content/80">Explore essays, tutorials, courses, and more.</p>
          <div class="flex gap-3 mt-2">
            <a href="/essay" class="btn btn-neutral">Start Reading</a>
            <a
              href="/login"
              class="btn btn-outline text-primary-content border-primary-content/30 hover:bg-primary-content/10"
              >Sign In</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
