---
import Layout from '@/layouts/Layout.astro';
import { getContentCounts, getFirstOfEachType } from '@/lib/content/getAllContent';
import { Icon } from 'astro-icon/components';

// Optimized: Load only what we need instead of all content
const firstOfEach = await getFirstOfEachType();
const counts = await getContentCounts();
const recipes = firstOfEach.recipe;
const books = firstOfEach.book;
const bookReviews = firstOfEach['book-review'];
const researchPapers = firstOfEach['research-paper'];
const patents = firstOfEach.patent;
const quotes = firstOfEach.quote;
const events = firstOfEach.event;
const conferences = firstOfEach.conference;
const workshops = firstOfEach.workshop;
const webinars = firstOfEach.webinar;
const courses = firstOfEach.course;
const courseLessons = firstOfEach['course-lesson'];
const essays = firstOfEach.essay;
const tutorials = firstOfEach.tutorial;
const podcasts = firstOfEach.podcast;

const contentGrid = [
  {
    title: recipes?.data.title ?? 'Recipe',
    desc: 'Ingredients, instructions, nutrition facts',
    href: recipes ? `/recipe/${recipes.id.replace('recipe/', '')}` : '/recipe',
    tag: 'Lifestyle',
  },
  {
    title: books?.data.title ?? 'Book',
    desc: 'Book details with ratings and reviews',
    href: books ? `/book/${books.id.replace('book/', '')}` : '/book',
    tag: 'Resources',
  },
  {
    title: bookReviews?.data.title ?? 'Book Review',
    desc: 'Critical analysis and personal take',
    href: bookReviews
      ? `/book-review/${bookReviews.id.replace('book-review/', '')}`
      : '/book-review',
    tag: 'Resources',
  },
  {
    title: researchPapers?.data.title ?? 'Research Paper',
    desc: 'Academic content with citations',
    href: researchPapers
      ? `/research-paper/${researchPapers.id.replace('research-paper/', '')}`
      : '/research-paper',
    tag: 'Academic',
  },
  {
    title: patents?.data.title ?? 'Patent',
    desc: 'Patent details and claims analysis',
    href: patents ? `/patent/${patents.id.replace('patent/', '')}` : '/patent',
    tag: 'Academic',
  },
  {
    title: quotes?.data.title ?? 'Quote',
    desc: 'Inspirational quotes with context',
    href: quotes ? `/quote/${quotes.id.replace('quote/', '')}` : '/quote',
    tag: 'Wisdom',
  },
  {
    title: events?.data.title ?? 'Hackathon',
    desc: '48-hour competition events',
    href: events ? `/event/${events.id.replace('event/', '')}` : '/event',
    tag: 'Events',
  },
  {
    title: conferences?.data.title ?? 'Conference',
    desc: 'Multi-track speaker events',
    href: conferences ? `/conference/${conferences.id.replace('conference/', '')}` : '/conference',
    tag: 'Events',
  },
  {
    title: workshops?.data.title ?? 'Workshop',
    desc: 'Hands-on learning sessions',
    href: workshops ? `/workshop/${workshops.id.replace('workshop/', '')}` : '/workshop',
    tag: 'Events',
  },
  {
    title: webinars?.data.title ?? 'Webinar',
    desc: 'Live online presentations',
    href: webinars ? `/webinar/${webinars.id.replace('webinar/', '')}` : '/webinar',
    tag: 'Events',
  },
  {
    title: courseLessons?.data.title ?? 'Course Lesson',
    desc: 'Individual video lesson view',
    href: courseLessons
      ? `/course-lesson/${courseLessons.id.replace('course-lesson/', '')}`
      : '/course-lesson',
    tag: 'Learning',
  },
  {
    title: essays?.data.title ?? 'Essay',
    desc: 'Deep-dive article layout',
    href: essays ? `/essay/${essays.id.replace('essay/', '')}` : '/essay',
    tag: 'Content',
  },
];
---

<Layout title="Vedify - Quality Content for Curious Minds">
  <!-- Hero -->
  <section class="relative overflow-hidden py-20 lg:py-32">
    <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-secondary/5">
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-transparent to-transparent"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="animate-slide-up">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium mb-6"
          >
            <Icon name="lucide:zap" class="h-4 w-4" />
            New: AI-powered content recommendations
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
            Quality content for
            <span
              class="block bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              curious minds
            </span>
          </h1>

          <p class="text-lg sm:text-xl text-base-content/70 mb-8 max-w-xl">
            Essays, tutorials, courses, and more. Every piece crafted with care, optimized for
            learning, and designed for the modern web.
          </p>

          <div class="flex flex-wrap gap-4">
            <a
              href="/essay"
              class="btn btn-primary btn-lg gap-2 shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 transition-all"
            >
              Start Reading <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
            <a href="/course" class="btn btn-outline btn-lg"> Explore Courses </a>
          </div>

          <div class="mt-10 flex items-center gap-6">
            <div class="flex -space-x-2">
              {
                [1, 2, 3, 4].map((i) => (
                  <img
                    src={`https://images.pexels.com/photos/${1100000 + i * 12345}/pexels-photo-${1100000 + i * 12345}.jpeg?auto=compress&cs=tinysrgb&w=80&h=80&fit=crop`}
                    alt=""
                    class="h-10 w-10 rounded-full border-2 border-base-100 object-cover"
                  />
                ))
              }
            </div>
            <div>
              <p class="text-sm font-medium">Join 10,000+ learners</p>
              <div class="flex items-center gap-1">
                {
                  Array.from({ length: 5 }).map(() => (
                    <Icon name="lucide:star" class="h-4 w-4 text-warning fill-warning" />
                  ))
                }
                <span class="text-sm text-base-content/60 ml-1">4.9 rating</span>
              </div>
            </div>
          </div>
        </div>

        <div class="hidden lg:block relative animate-fade-in">
          <div
            class="absolute inset-0 bg-gradient-to-r from-primary/20 to-secondary/20 blur-3xl rounded-full"
          >
          </div>
          <div
            class="relative bg-gradient-to-br from-base-100 to-base-200 rounded-2xl border border-base-300 shadow-xl p-6"
          >
            <div class="grid grid-cols-2 gap-4">
              {
                [
                  {
                    title: 'Architecture Essays',
                    count: String(counts.essay ?? 0),
                    icon: 'file-text',
                    color: 'from-primary to-blue-400',
                  },
                  {
                    title: 'Video Tutorials',
                    count: String(counts.tutorial ?? 0),
                    icon: 'play-circle',
                    color: 'from-secondary to-cyan-400',
                  },
                  {
                    title: 'Courses',
                    count: String(counts.course ?? 0),
                    icon: 'book-open',
                    color: 'from-accent to-emerald-400',
                  },
                  {
                    title: 'Podcast Episodes',
                    count: String(counts.podcast ?? 0),
                    icon: 'mic',
                    color: 'from-warning to-orange-400',
                  },
                ].map((item) => (
                  <div class="p-4 rounded-xl bg-base-200/50 border border-base-300 hover:border-primary/30 hover:bg-base-200 transition-all">
                    <div
                      class={`h-10 w-10 rounded-lg bg-gradient-to-br ${item.color} flex items-center justify-center mb-3`}
                    >
                      <Icon name={`lucide:${item.icon}`} class="h-5 w-5 text-white" />
                    </div>
                    <p class="font-semibold text-2xl">{item.count}</p>
                    <p class="text-sm text-base-content/60">{item.title}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features strip -->
  <section class="border-y border-base-300 bg-base-200/30 py-8">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {
          [
            { icon: 'zap', label: 'Fast Performance', desc: 'Optimized for speed' },
            { icon: 'shield-check', label: 'Accessible', desc: 'WCAG 2.1 compliant' },
            { icon: 'users', label: 'Community', desc: '10,000+ members' },
            { icon: 'star', label: 'High Quality', desc: 'Expert-reviewed' },
          ].map((item) => (
            <div class="flex flex-col items-center gap-2">
              <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center">
                <Icon name={`lucide:${item.icon}`} class="h-6 w-6 text-primary" />
              </div>
              <p class="font-medium">{item.label}</p>
              <p class="text-sm text-base-content/60">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Content types -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Content for Every Need</h2>
        <p class="text-lg text-base-content/60">
          From quick reads to deep dives, we have content types for every learning style.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {
          [
            {
              icon: 'file-text',
              title: 'Essays & Articles',
              desc: 'In-depth analysis and thoughtful opinions',
              href: essays ? `/essay/${essays.id}` : '/essay',
              color: 'from-primary to-secondary',
            },
            {
              icon: 'code',
              title: 'Tutorials',
              desc: 'Step-by-step guides to build real projects',
              href: tutorials ? `/tutorial/${tutorials.id.replace('tutorial/', '')}` : '/tutorial',
              color: 'from-accent to-emerald-400',
            },
            {
              icon: 'book-open',
              title: 'Courses',
              desc: 'Structured learning paths with certificates',
              href: courses ? `/course/${courses.id}` : '/course',
              color: 'from-secondary to-cyan-400',
            },
            {
              icon: 'mic',
              title: 'Podcasts',
              desc: 'Audio content to learn on the go',
              href: podcasts ? `/podcast/${podcasts.id.replace('podcast/', '')}` : '/podcast',
              color: 'from-warning to-error',
            },
          ].map((item) => (
            <a
              href={item.href}
              class="group relative overflow-hidden p-6 border border-base-300 rounded-xl bg-base-100 hover:shadow-xl transition-all duration-300"
            >
              <div
                class={`absolute inset-0 bg-gradient-to-br ${item.color} opacity-0 group-hover:opacity-5 transition-opacity`}
              />
              <div
                class={`h-14 w-14 rounded-xl bg-gradient-to-br ${item.color} flex items-center justify-center mb-4 group-hover:scale-110 transition-transform`}
              >
                <Icon name={`lucide:${item.icon}`} class="h-7 w-7 text-white" />
              </div>
              <h3 class="font-semibold text-lg mb-2">{item.title}</h3>
              <p class="text-sm text-base-content/60 mb-4">{item.desc}</p>
              <span class="text-sm font-medium text-primary flex items-center gap-1">
                Explore{' '}
                <Icon
                  name="lucide:arrow-right"
                  class="h-4 w-4 group-hover:translate-x-1 transition-transform"
                />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- All content grid -->
  <section class="py-16 bg-base-200/30">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-12">Explore All Content Types</h2>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          contentGrid.map((item) => (
            <a
              href={item.href}
              class="group flex items-start justify-between p-5 border border-base-300 rounded-xl bg-base-100 hover:bg-base-200/50 hover:shadow-md transition-all"
            >
              <div>
                <span class="text-xs font-medium text-primary mb-1 block">{item.tag}</span>
                <h3 class="font-semibold mb-1">{item.title}</h3>
                <p class="text-sm text-base-content/60">{item.desc}</p>
              </div>
              <Icon
                name="lucide:arrow-right"
                class="h-5 w-5 text-base-content/40 group-hover:translate-x-1 group-hover:text-base-content transition-all shrink-0"
              />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4">
      <div
        class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary to-secondary p-8 md:p-12 lg:p-16 text-center"
      >
        <div
          class="absolute inset-0 opacity-30"
          style="background-image: radial-gradient(circle, rgba(255,255,255,0.15) 1px, transparent 1px); background-size: 24px 24px;"
        >
        </div>
        <div class="relative max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-primary-content mb-4">
            Never miss an update
          </h2>
          <p class="text-lg text-primary-content/80 mb-8">
            Subscribe to get the latest essays, tutorials, and courses delivered straight to your
            inbox.
          </p>
          <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
            <input
              type="email"
              placeholder="Enter your email"
              class="input input-bordered flex-1 bg-base-100/10 border-base-100/20 text-primary-content placeholder:text-primary-content/60"
            />
            <button type="submit" class="btn btn-neutral">Subscribe</button>
          </form>
          <p class="text-sm text-primary-content/60 mt-4">
            Join 10,000+ learners. No spam, unsubscribe anytime.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech stack -->
  <section class="py-16 border-t border-base-300">
    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">Built with Modern Tools</h2>
        <p class="text-base-content/60 mb-8">
          This site demonstrates production-ready layouts for all content types defined in the
          Vedify schema, with proper mobile-first design and accessibility features.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          {
            ['Astro', 'DaisyUI', 'Tailwind CSS', 'TypeScript', 'Astro Icon'].map((tech) => (
              <span class="badge badge-lg badge-outline border-base-300 hover:badge-primary transition-colors py-3 px-4 text-sm font-medium">
                {tech}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Layout>
