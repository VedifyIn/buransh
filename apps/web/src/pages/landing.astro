---
import Layout from '@/layouts/Layout.astro';
import { getContentCounts, getFirstOfEachType } from '@/lib/content/getAllContent';
import { Icon } from 'astro-icon/components';

// Optimized: Load only what we need
const firstOfEach = await getFirstOfEachType();
const contentCounts = await getContentCounts();

const essays = firstOfEach.essay;
const tutorials = firstOfEach.tutorial;
const courses = firstOfEach.course;
const podcasts = firstOfEach.podcast;
const recipes = firstOfEach.recipe;

const stats = [
  {
    value: String((contentCounts.essay || 0) + (contentCounts.tutorial || 0)),
    label: 'Articles & Tutorials',
    icon: 'file-text',
  },
  {
    value: String((contentCounts.course || 0) + (contentCounts['course-lesson'] || 0)),
    label: 'Course Lessons',
    icon: 'book-open',
  },
  { value: String(contentCounts.podcast || 0), label: 'Podcast Episodes', icon: 'mic' },
  {
    value: String(
      (contentCounts.event || 0) +
        (contentCounts.conference || 0) +
        (contentCounts.workshop || 0) +
        (contentCounts.webinar || 0),
    ),
    label: 'Live Events',
    icon: 'calendar',
  },
];

const features = [
  {
    icon: 'zap',
    title: 'Lightning Fast',
    desc: 'Static-first architecture with on-demand server rendering. Pages load in milliseconds.',
  },
  {
    icon: 'shield-check',
    title: 'Privacy First',
    desc: 'Your data stays yours. Bookmarks, highlights, and preferences are tied to your account, not sold.',
  },
  {
    icon: 'book-open',
    title: 'Every Content Type',
    desc: 'Essays, tutorials, courses, podcasts, recipes, research papers — one platform, fifteen formats.',
  },
  {
    icon: 'users',
    title: 'Community Driven',
    desc: 'Comments, claps, ratings, and bookmarks. Engage with content and creators meaningfully.',
  },
  {
    icon: 'palette',
    title: 'Beautiful by Default',
    desc: 'Meticulously designed layouts for every content type. Dark mode, font controls, and responsive.',
  },
  {
    icon: 'rss',
    title: 'Subscribe & Sync',
    desc: 'RSS feed, newsletter, and cross-device sync. Pick up where you left off, anywhere.',
  },
];

const testimonials = [
  {
    name: 'Sarah Chen',
    role: 'Software Engineer',
    text: "The essays on distributed systems are some of the best I've read. Clear, deep, and beautifully presented.",
    avatar:
      'https://images.pexels.com/photos/774909/pexels-photo-774909.jpeg?auto=compress&cs=tinysrgb&w=120&h=120&fit=crop',
  },
  {
    name: 'Marcus Webb',
    role: 'Product Designer',
    text: 'Finally a content platform that respects typography and reading comfort. The font controls are a game changer.',
    avatar:
      'https://images.pexels.com/photos/220453/pexels-photo-220453.jpeg?auto=compress&cs=tinysrgb&w=120&h=120&fit=crop',
  },
  {
    name: 'Priya Sharma',
    role: 'CS Student',
    text: 'The courses are structured so well. I went from zero to building a real project in a weekend.',
    avatar:
      'https://images.pexels.com/photos/1239291/pexels-photo-1239291.jpeg?auto=compress&cs=tinysrgb&w=120&h=120&fit=crop',
  },
];

const contentCards = [
  {
    type: 'Essay',
    title: essays?.data.title ?? 'Latest Essay',
    desc: 'In-depth analysis and thoughtful opinions',
    href: essays ? `/essay/${essays.id}` : '/essay',
    icon: 'file-text',
    gradient: 'from-primary to-secondary',
  },
  {
    type: 'Tutorial',
    title: tutorials?.data.title ?? 'Latest Tutorial',
    desc: 'Step-by-step guides to build real projects',
    href: tutorials ? `/tutorial/${tutorials.id}` : '/tutorial',
    icon: 'code',
    gradient: 'from-accent to-emerald-400',
  },
  {
    type: 'Course',
    title: courses?.data.title ?? 'Latest Course',
    desc: 'Structured learning paths with certificates',
    href: courses ? `/course/${courses.id}` : '/course',
    icon: 'book-open',
    gradient: 'from-secondary to-cyan-400',
  },
  {
    type: 'Podcast',
    title: podcasts?.data.title ?? 'Latest Episode',
    desc: 'Audio content to learn on the go',
    href: podcasts ? `/podcast/${podcasts.id}` : '/podcast',
    icon: 'mic',
    gradient: 'from-warning to-orange-400',
  },
];
---

<Layout
  title="Vedify - Quality Content for Curious Minds"
  description="Essays, tutorials, courses, podcasts, and more. Every piece crafted with care, optimized for learning, and designed for the modern web."
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-20 lg:py-32">
    <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-secondary/5">
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-transparent to-transparent"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="animate-slide-up">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-sm font-medium mb-6"
          >
            <Icon name="lucide:sparkles" class="h-4 w-4" />
            New: AI-powered content recommendations
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
            Quality content for
            <span
              class="block bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              curious minds
            </span>
          </h1>

          <p class="text-lg sm:text-xl text-base-content/70 mb-8 max-w-xl">
            Essays, tutorials, courses, podcasts, and more. Every piece crafted with care, optimized
            for learning, and designed for the modern web.
          </p>

          <div class="flex flex-wrap gap-4">
            <a
              href="/essay"
              class="btn btn-primary btn-lg gap-2 shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 transition-all"
            >
              Start Reading <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
            <a href="/course" class="btn btn-outline btn-lg gap-2">
              <Icon name="lucide:graduation-cap" class="h-4 w-4" />
              Explore Courses
            </a>
          </div>

          <div class="mt-10 flex items-center gap-6">
            <div class="flex -space-x-2">
              {
                testimonials.map((t) => (
                  <img
                    src={t.avatar}
                    alt=""
                    class="h-10 w-10 rounded-full border-2 border-base-100 object-cover"
                  />
                ))
              }
            </div>
            <div>
              <p class="text-sm font-medium">Join 10,000+ learners</p>
              <div class="flex items-center gap-1">
                {
                  Array.from({ length: 5 }).map(() => (
                    <Icon name="lucide:star" class="h-4 w-4 text-warning fill-warning" />
                  ))
                }
                <span class="text-sm text-base-content/60 ml-1">4.9 rating</span>
              </div>
            </div>
          </div>
        </div>

        <div class="hidden lg:block relative animate-fade-in">
          <div
            class="absolute inset-0 bg-gradient-to-r from-primary/20 to-secondary/20 blur-3xl rounded-full"
          >
          </div>
          <div
            class="relative bg-gradient-to-br from-base-100 to-base-200 rounded-2xl border border-base-300 shadow-xl p-6"
          >
            <div class="grid grid-cols-2 gap-4">
              {
                stats.map((item) => (
                  <div class="p-4 rounded-xl bg-base-200/50 border border-base-300 hover:border-primary/30 hover:bg-base-200 transition-all">
                    <div class="flex items-center gap-2 mb-2">
                      <div class="h-8 w-8 rounded-lg bg-primary/10 flex items-center justify-center">
                        <Icon name={`lucide:${item.icon}`} class="h-4 w-4 text-primary" />
                      </div>
                      <p class="font-bold text-2xl">{item.value}</p>
                    </div>
                    <p class="text-sm text-base-content/60">{item.label}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <section class="border-y border-base-300 bg-base-200/30 py-8">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {
          stats.map((item) => (
            <div class="flex flex-col items-center gap-1">
              <p class="text-3xl font-bold text-primary">{item.value}</p>
              <p class="text-sm text-base-content/60">{item.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Why Vedify?</h2>
        <p class="text-lg text-base-content/60">
          A content platform built for readers, learners, and creators who care about quality.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          features.map((item) => (
            <div class="group p-6 rounded-2xl border border-base-300 bg-base-100 hover:shadow-lg hover:border-primary/30 transition-all">
              <div class="h-12 w-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                <Icon name={`lucide:${item.icon}`} class="h-6 w-6 text-primary" />
              </div>
              <h3 class="font-semibold text-lg mb-2">{item.title}</h3>
              <p class="text-sm text-base-content/60">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Latest content -->
  <section class="py-16 bg-base-200/30">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold">Fresh from the press</h2>
          <p class="text-base-content/60 mt-2">
            The latest essays, tutorials, courses, and episodes.
          </p>
        </div>
        <a href="/essay" class="btn btn-ghost gap-1 hidden sm:flex">
          View all <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          contentCards.map((item) => (
            <a
              href={item.href}
              class="group card bg-base-100 border border-base-300 rounded-2xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
            >
              <div
                class={`h-32 bg-gradient-to-br ${item.gradient} flex items-center justify-center`}
              >
                <Icon name={`lucide:${item.icon}`} class="h-12 w-12 text-white/90" />
              </div>
              <div class="card-body p-5">
                <span class="text-xs font-medium text-primary uppercase tracking-wider">
                  {item.type}
                </span>
                <h3 class="font-semibold text-lg leading-snug group-hover:text-primary transition-colors">
                  {item.title}
                </h3>
                <p class="text-sm text-base-content/60">{item.desc}</p>
                <span class="text-sm font-medium text-primary flex items-center gap-1 mt-2">
                  Read more{' '}
                  <Icon
                    name="lucide:arrow-right"
                    class="h-4 w-4 group-hover:translate-x-1 transition-transform"
                  />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Loved by learners</h2>
        <p class="text-lg text-base-content/60">Don't just take our word for it.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {
          testimonials.map((t) => (
            <div class="card bg-base-100 border border-base-300 rounded-2xl">
              <div class="card-body">
                <div class="flex items-center gap-1 mb-3">
                  {Array.from({ length: 5 }).map(() => (
                    <Icon name="lucide:star" class="h-4 w-4 text-warning fill-warning" />
                  ))}
                </div>
                <p class="text-base-content/80 italic mb-4">"{t.text}"</p>
                <div class="flex items-center gap-3">
                  <img src={t.avatar} alt={t.name} class="w-10 h-10 rounded-full object-cover" />
                  <div>
                    <p class="font-medium text-sm">{t.name}</p>
                    <p class="text-xs text-base-content/50">{t.role}</p>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4">
      <div
        class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary to-secondary p-8 md:p-12 lg:p-16 text-center"
      >
        <div
          class="absolute inset-0 opacity-30"
          style="background-image: radial-gradient(circle, rgba(255,255,255,0.15) 1px, transparent 1px); background-size: 24px 24px;"
        >
        </div>
        <div class="relative max-w-2xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-primary-content mb-4">
            Never miss an update
          </h2>
          <p class="text-lg text-primary-content/80 mb-8">
            Subscribe to get the latest essays, tutorials, and courses delivered straight to your
            inbox.
          </p>
          <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
            <input
              type="email"
              placeholder="Enter your email"
              class="input input-bordered flex-1 bg-base-100/10 border-base-100/20 text-primary-content placeholder:text-primary-content/60"
            />
            <button type="submit" class="btn btn-neutral">Subscribe</button>
          </form>
          <p class="text-sm text-primary-content/60 mt-4">
            Join 10,000+ learners. No spam, unsubscribe anytime.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
