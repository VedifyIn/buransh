---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="404" description="Page not found">
  <div id="chaos-bg" class="fixed inset-0 bg-[#0A0808] z-0 overflow-hidden">
    <div
      class="absolute inset-0 opacity-5"
      style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🔥</text></svg>'); background-size: 60px;"
    >
    </div>

    <div
      class="absolute top-12 left-[10%] text-lg font-['Comic_Sans_MS'] text-lime-500/30 animate-pulse"
    >
      🚀 FREE KNOWLEDGE!!!
    </div>
    <div class="absolute top-24 right-[15%] text-sm font-['Comic_Sans_MS'] text-pink-500/30">
      FULL STACK IN 5 MIN ➡ CLICK HERE
    </div>
    <div class="absolute top-40 left-[30%] text-base font-['Comic_Sans_MS'] text-yellow-500/30">
      YOU WON'T BELIEVE #7!
    </div>
    <div class="absolute bottom-20 right-[20%] text-sm font-['Comic_Sans_MS'] text-cyan-400/30">
      ⏰ LIMITED INSIGHT ⏰
    </div>
    <div class="absolute top-1/3 right-[10%] text-2xl text-amber-600/20 font-['Comic_Sans_MS']">
      %%CLICKBAIT%%
    </div>
    <div class="absolute bottom-32 left-[15%] text-base text-red-400/20 font-['Comic_Sans_MS']">
      ⚡ 10X YOUR OUTPUT ⚡
    </div>

    <div class="absolute inset-0" id="chaos-click-target"></div>
  </div>

  <div id="modal-overlay" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60">
    <div
      id="modal"
      class="bg-base-100 border-2 border-primary rounded-box p-8 max-w-md mx-4 shadow-2xl text-center animate-modal-enter"
    >
      <div class="text-4xl mb-4">🔥</div>
      <h2 class="text-xl font-bold mb-2">Are you sure this is where you want to be?</h2>
      <p class="text-sm text-base-content/60 mb-6">
        This page doesn't exist. But hey, there's still time to make good choices.
      </p>
      <div class="flex gap-3 justify-center">
        <a href="/" class="btn btn-primary px-8">Back home</a>
        <button id="noise-btn" class="btn btn-outline px-6">I enjoy the noise</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  const modalOverlay = document.getElementById('modal-overlay')!;
  const noiseBtn = document.getElementById('noise-btn')!;
  const chaosTarget = document.getElementById('chaos-click-target')!;

  noiseBtn.addEventListener('click', () => {
    modalOverlay.classList.add('hidden');
  });

  chaosTarget.addEventListener('click', () => {
    modalOverlay.classList.remove('hidden');
  });
</script>

<style is:global>
  .animate-modal-enter {
    animation: modalEnter 300ms ease-out;
  }
  @keyframes modalEnter {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
